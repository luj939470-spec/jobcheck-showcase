NODE_ENV=development
PORT=3000

# PostgreSQL connection string used by Prisma.
DATABASE_URL=postgresql://jobcheck:jobcheck@localhost:5432/jobcheck?schema=public

# Use a long, random value (at least 32 characters) outside local development.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:5173

# debug | info | warn | error
LOG_LEVEL=debug

# AI provider: DOUBAO | QIANWEN. Never commit real API keys.
AI_PROVIDER=DOUBAO
DOUBAO_API_KEY=
DOUBAO_MODEL=doubao-seed-1-6-250615
QIANWEN_API_KEY=
QIANWEN_MODEL=qwen-plus

# Per-user AI request rate limit.
AI_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_WINDOW_MS=60000
AI_TIMEOUT_MS=30000
